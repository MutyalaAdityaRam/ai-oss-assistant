{
	"folders": [
		{
			"name": "Root Project",
			"path": "."
		},
		{
			"name": "Backend (PHP/MySQL)",
			"path": "ai-oss-assistant-backend"
		},
		{
			"name": "Frontend (Next.js)",
			"path": "ai-oss-assistant-frontend"
		},
		{
			"name": "Actions & Automation (Python)",
			"path": "ai-oss-assistant-actions"
		}
	],
	"settings": {
		"editor.formatOnSave": true,
		"editor.tabSize": 4,
		"files.exclude": {
			"**/node_modules": true,
			"**/vendor": true,
			"**/.next": true
		},
		"php.suggest.basic": true,
		"typescript.tsdk": "ai-oss-assistant-frontend/node_modules/typescript/lib"
	},
	"extensions": {
		"recommendations": [
			"bmewburn.vscode-intelephense-client",
			"dbaeumer.vscode-eslint",
			"esbenp.prettier-vscode",
			"ms-python.python",
			"ms-azuretools.vscode-docker",
			"ms-vscode-remote.remote-containers"
		]
	}
}
