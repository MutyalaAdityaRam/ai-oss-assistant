# Backend Environment Variables Template (Public Safe)

# Application & Auth
APP_ENV=development
APP_DEBUG=true
API_BEARER_TOKEN=generate_a_secure_random_hex_token_here

# Database Settings (Local / Docker)
DB_HOST=127.0.0.1
DB_NAME=ai_oss_assistant
DB_USER=root
DB_PASS=your_db_password_here
DB_PORT=3306

# GitHub App & Integration Credentials
GITHUB_USER=your_github_username
GITHUB_TOKEN=your_personal_access_token_here
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=generate_a_secure_random_webhook_secret_here

# NVIDIA API Base Endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Primary Models (Llama 3.2 11B Vision Instruct)
NVIDIA_MODEL_PRO=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY_PRO=nvapi-your_pro_api_key_here

NVIDIA_MODEL_FLASH=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY_FLASH=nvapi-your_flash_api_key_here

# Failover Backup Models
NVIDIA_MODEL_PRO_BACKUP1=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY_PRO_BACKUP1=nvapi-your_backup1_key_here

NVIDIA_MODEL_PRO_BACKUP2=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY_PRO_BACKUP2=nvapi-your_backup2_key_here

NVIDIA_MODEL_FLASH_BACKUP1=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY_FLASH_BACKUP1=nvapi-your_backup3_key_here

NVIDIA_MODEL_FLASH_BACKUP2=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY_FLASH_BACKUP2=nvapi-your_backup4_key_here

# System Settings
MAX_RETRIES=5
FORK_EXPIRY_DAYS=14
LLM_SPEND_CAP_USD=50.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ai-oss-assistant.alwaysdata.net
