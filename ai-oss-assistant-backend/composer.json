{
    "name": "ai-oss/backend",
    "description": "AI Open Source Contribution Assistant — PHP Backend Orchestrator",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "AiOssAssistant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AiOssAssistant\\Tests\\": "tests/"
        }
    },
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "scripts": {
        "test": "vendor/phpunit/phpunit/phpunit",
        "test:unit": "vendor/phpunit/phpunit/phpunit --testsuite unit",
        "test:integration": "vendor/phpunit/phpunit/phpunit --testsuite integration"
    }
}
